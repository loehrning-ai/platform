{
  "name": "@loehrning/website",
  "version": "1.0.0",
  "type": "module",
  "description": "German-language AI learning platform application.",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE_POLICY.md",
  "scripts": {
    "predev": "bun run english-routes:check",
    "dev": "next dev --experimental-next-config-strip-types",
    "prebuild": "bun run validate-env",
    "build": "node scripts/build-freshness.mjs build",
    "analyze": "bun run prebuild && ANALYZE=true node scripts/build-freshness.mjs build",
    "start": "next start --experimental-next-config-strip-types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typegen": "node scripts/run-provider-free.mjs env __NEXT_NODE_NATIVE_TS_LOADER_ENABLED=true bun run next typegen --webpack",
    "pretypecheck": "bun run typegen",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretypecheck:test": "bun run typegen",
    "typecheck:test": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server-log-privacy": "node scripts/run-provider-free.mjs bun run build && bun run test:server-log-privacy:built",
    "test:server-log-privacy:built": "node scripts/run-provider-free.mjs node scripts/run-built-gate.mjs node scripts/verify-server-log-privacy.mjs",
    "test:e2e": "node scripts/run-provider-free.mjs bun run build && bun run e2e:shard:built test --project=chromium",
    "test:e2e:dev": "E2E_SERVER_MODE=development node scripts/run-provider-free.mjs node scripts/run-playwright.mjs test",
    "test:e2e:konto-dom-mocked": "node scripts/run-mock-auth-e2e.mjs",
    "test:e2e:konto-dom-mocked:built": "node scripts/run-mock-auth-e2e.mjs --built",
    "test:e2e:authenticated-live": "node scripts/run-live-auth-e2e.mjs",
    "test:e2e:authenticated-live:built": "node scripts/run-live-auth-e2e.mjs --built",
    "test:e2e:release": "RELEASE_VALIDATION=1 bun run validate-env && node scripts/run-provider-free.mjs bun run build && bun run test:e2e:release:built",
    "test:e2e:release:built": "E2E_GLOBAL_TIMEOUT=${E2E_GLOBAL_TIMEOUT:-600000} RELEASE_VALIDATION=1 E2E_SERVER_MODE=production RUN_LAUNCH_GATE=1 node scripts/run-provider-free.mjs node scripts/run-built-gate.mjs node scripts/run-playwright.mjs test --grep @launch-gate --project=chromium --retries=0 --trace=retain-on-failure",
    "build:freshness:verify": "node scripts/build-freshness.mjs verify",
    "build:freshness:verify:provider-free": "node scripts/run-provider-free.mjs node scripts/build-freshness.mjs verify",
    "validate-env": "node scripts/validate-env.mjs",
    "registry:export": "node scripts/export-registry.mjs",
    "registry:check": "node scripts/export-registry.mjs --check",
    "english-routes:generate": "node scripts/generate-english-route-mirror.mjs",
    "english-routes:check": "node scripts/generate-english-route-mirror.mjs --check",
    "demo-tiles:generate": "node scripts/demo-tiles/build-css.mjs",
    "demo-tiles:check": "node scripts/demo-tiles/build-css.mjs --check",
    "page-inventory:generate": "bun scripts/generate-page-inventory.mjs",
    "page-inventory:check": "bun scripts/generate-page-inventory.mjs --check",
    "skills:mirror-check": "node scripts/skills-mirror-check.mjs",
    "precontent:lint": "bun run registry:check",
    "content:lint": "node scripts/content-lint.mjs",
    "content:voice-report": "node scripts/content-voice-report.mjs",
    "book:data": "node scripts/export-book-data.mjs",
    "book:data:check": "node scripts/export-book-data.mjs --check",
    "book:tokens": "node scripts/list-book-tokens.mjs",
    "migrations:check": "node scripts/verify-migrations-tracked.mjs",
    "verify": "bun run --cwd ../.. ci",
    "verify:build": "E2E_SERVER_MODE=${E2E_SERVER_MODE:-production} E2E_PORT=${E2E_PORT:-3000} node scripts/run-provider-free.mjs bun run build",
    "e2e:shard:built": "E2E_SERVER_MODE=production node scripts/run-provider-free.mjs node scripts/run-built-gate.mjs node scripts/run-playwright.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/hashes": "2.3.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "import-in-the-middle": "^3.3.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "16.4.2",
    "@next/env": "16.4.2",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2"
  }
}
