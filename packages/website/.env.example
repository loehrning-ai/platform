# ─────────────────────────────────────────────────────────────
# loehrning.ai Free Learning Platform — environment variables
# Copy to .env.local and fill in the values for your environment.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# Optional AI features. Without this key, AI-backed exercise grading
# (AI-Native practice mode) is unavailable. The course is still accessible
# in read-only mode without this key.
ANTHROPIC_API_KEY=

# Optional AI-Native live practice mode. Default is disabled.
# Controls Claude API calls for exercise grading — not scan features.
# Production activation also requires the complete Supabase configuration
# below because AI request quotas use the durable fail-closed rate limiter.
AI_NATIVE_PRACTICE_ENABLED=false
# Required when ANTHROPIC_API_KEY is configured. Non-secret attestation date;
# never fill this until the Anthropic DPA has actually been accepted.
ANTHROPIC_DPA_CONFIRMED_AT=
# Required before configuring the key. Record the actual API input/output
# retention period in the accepted Anthropic contract; 0 is valid only when
# the contract explicitly states no provider retention for this API traffic.
ANTHROPIC_RETENTION_DAYS=

# ── Supabase auth (public) ────────────────────────────────────
# Required for login, cross-device progress sync, and certificate history.
# Anonymous learners can read books, demos, technical labs, and course landing
# pages without these vars. The four native core-course readers, quizzes,
# progress, and certificates require a configured learning account.
# Use the standard https://<project-ref>.supabase.co project origin. Custom
# domains are rejected until their exact origins are code-reviewed and allowed.
NEXT_PUBLIC_SUPABASE_URL=
# Use an sb_publishable_ key. Never place an sb_secret_ or service_role JWT in
# any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may expose this instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# ── Supabase server-only config ───────────────────────────────
# Required for privileged server operations (progress sync, DSGVO export,
# account delete). Never expose this key to the browser.
SUPABASE_URL=
# Use an sb_secret_ key or a legacy JWT whose role claim is service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Required with the protected Supabase backend. This server-only 256-bit key
# HMACs rate-limit identities so a database dump cannot enumerate IPv4 hashes.
# Generate once per environment; never copy it into a NEXT_PUBLIC_ variable:
#   printf 'rlh1_%s\n' "$(openssl rand -hex 32)"
RATE_LIMIT_HMAC_SECRET=

# Required when any Supabase variable is configured. Use the provider's exact
# region identifier. The release gate accepts only explicit EU identifiers.
SUPABASE_REGION=
# Non-secret attestation date; set only after the Supabase DPA is accepted.
SUPABASE_DPA_CONFIRMED_AT=

# ── Magic-link bot and abuse protection ──────────────────────
# Required whenever Supabase Auth is enabled. Create a Cloudflare Turnstile
# Managed widget restricted to the exact production/preview hostnames. Put only
# its public site key here. Configure the matching secret exclusively in
# Supabase Auth > Bot and Abuse Protection; never place that secret in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set only after CAPTCHA protection is enabled in the live Supabase Auth
# project and a real token has been verified end to end.
SUPABASE_CAPTCHA_CONFIRMED_AT=
# Set only after Turnstile hostname restrictions and applicable privacy/data
# processing terms have been reviewed and recorded.
TURNSTILE_CONFIGURATION_CONFIRMED_AT=

# Stored free-text feedback is opt-in and independent from learning accounts.
# Before setting this true, apply every migration, enable Supabase Cron, and
# verify the migration-created beta-feedback-retention-daily job documented in
# README.md. Do not create a second job manually. The attestation date must
# reflect verification of that exact live job; it is not a placeholder.
FEEDBACK_ENABLED=false
FEEDBACK_RETENTION_CRON_CONFIRMED_AT=

# ── Public site/app URL (unused, do not set) ─────────────────
# The canonical origin is HARDCODED to https://loehrning.ai in
# src/lib/seo/entity.ts (SITE_ORIGIN), src/app/layout.tsx (metadataBase)
# and src/lib/pdf/certificate-pdf.ts. No runtime code reads these vars,
# so they are not required in any environment. If one is set anyway
# (for example a stale Vercel env), scripts/validate-env.mjs requires it
# to equal https://loehrning.ai exactly, as a guard against half-migrations.
# NEXT_PUBLIC_SITE_URL=https://loehrning.ai
# NEXT_PUBLIC_APP_URL=https://loehrning.ai

# ── Server-signed certificates (future) ──────────────────────
# Required only if server-signed certificates are implemented.
# Leave blank / commented out at launch. Generate with:
#   openssl rand -hex 32
# CERTIFICATE_HMAC_SECRET=

# ── Custom SMTP note ──────────────────────────────────────────
# Note: custom SMTP must be configured in the Supabase Auth dashboard,
# not here. Verify the provider's current production limits and configure an
# appropriate SMTP service before enabling public account emails.

# ── Isolated live-auth E2E (do not store credentials here) ───
# The explicit `test:e2e:authenticated-live` command reads these from the
# invoking shell or secret facility. It requires a dedicated disposable test
# project. TEST_URL must equal NEXT_PUBLIC_SUPABASE_URL and both publishable-key
# values must be identical. There is no service-role or mock-key fallback.
# SIMPLIFIED_SUPABASE_TEST_URL=
# SIMPLIFIED_SUPABASE_TEST_PUBLISHABLE_KEY=
# SIMPLIFIED_SUPABASE_TEST_EMAIL=
# SIMPLIFIED_SUPABASE_TEST_PASSWORD=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Sentry telemetry (optional) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Server and public DSNs must identify the same project when both are set.
# SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT are an all-or-nothing
# source-map upload group. Any Sentry configuration requires a DSN plus the
# following attestations. Do not guess retention from a provider default.
SENTRY_DPA_CONFIRMED_AT=
SENTRY_RETENTION_DAYS=

# ── Vercel hosting and optional telemetry ──────────────────────────
# VERCEL=1 and VERCEL_ENV are supplied by Vercel. Do not set them locally.
# A Vercel runtime requires a recorded DPA acceptance date.
VERCEL_DPA_CONFIRMED_AT=
# Analytics and Speed Insights are opt-in. Hosting on Vercel does not activate
# them by itself. Enable only after a documented TDDDG assessment.
VERCEL_TELEMETRY_ENABLED=false
VERCEL_TDDDG_ASSESSMENT_AT=
