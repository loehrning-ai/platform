      "input": {
        "command": "cd .; python3 -I - <<'E'\nimport csv\nrows=list(csv.reader(open('linsensuppe-woechentlich.csv'),delimiter=';'))[1:]\nseen=set();R=[]\nfor r in rows:\n    if r[0] in seen: print(\"DUP\",r);continue\n    seen.add(r[0]);R.append(r)\nfor w,i,p,h in R:\n    if w>='2024-12-30':\n        e=(int(p)-int(i)) if i and p else None\n        print(w,i,p,e,h)\ndef acc(sel):\n    a=sum(abs(int(p)-int(i)) for w,i,p,h in sel); s=sum(int(i) for w,i,p,h in sel)\n    return 1-a/s, len(sel)\nbase=[r for r in R if '2024-12-30'<=r[0]<='2025-12-22' and r[1] and r[2] and 'ausverkauft' not in r[3]]\nprint(acc(base))\nprint(acc([r for r in R if '2025-01-01'<=r[0]<='2025-12-22' and r[1] and r[2]]))\n# bias by period\nimport statistics as st\ndef bias(a,b): x=[int(p)-int(i) for w,i,p,h in R if a<=w<=b and i and p and not h]; return round(st.mean(x),1),len(x)\nfor a,b in [('2024-01-01','2025-03-31'),('2025-04-14','2025-05-05'),('2025-05-19','2025-06-09'),('2025-06-16','2025-12-22'),('2024-01-01','2024-12-30')]:\n    print(a,b,bias(a,b))\nE",
        "description": "Compute forecast errors, accuracy and bias"
      }
