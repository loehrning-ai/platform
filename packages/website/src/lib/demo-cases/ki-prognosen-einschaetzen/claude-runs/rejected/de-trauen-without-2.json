        "command": "cd .; python3 -I - <<'E'\nimport csv\nr=list(csv.DictReader(open('linsensuppe-woechentlich.csv'),delimiter=';'))\nd={x['woche']:x for x in r}\ncl=[x for x in d.values() if x['prognose'] and x['ist'] and not x['hinweis']]\nallE=[int(x['ist'])-int(x['prognose']) for x in cl]\nrecE=[int(x['ist'])-int(x['prognose']) for x in cl if x['woche']>='2025-06-01']\nF=729\nfor name,E in [('alle',allE),('ab Jun25',recE)]:\n  for co,lab in [(0.40,'Kantine'),(1.60,'ohne')]:\n    best=min(range(680,800),key=lambda q:sum(1.5*max(F+e-q,0)+co*max(q-F-e,0) for e in E)/len(E))\n    cost=lambda q:sum(1.5*max(F+e-q,0)+co*max(q-F-e,0) for e in E)/len(E)\n    print(name,lab,'best',best,round(cost(best),1),'cost@729',round(cost(729),1),'@750',round(cost(750),1),'@720',round(cost(720),1))\nE",
        "description": "Newsvendor expected cost by quantity"
