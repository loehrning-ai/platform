        "command": "cd .; python3 -I - <<'E'\nimport csv,statistics as st\nr=list(csv.DictReader(open('linsensuppe-woechentlich.csv'),delimiter=';'))\nseen=set();rows=[]\nfor x in r:\n    if x['woche'] in seen: print('dup',x['woche']);continue\n    seen.add(x['woche']);rows.append(x)\ndef acc(sel):\n    return 1-sum(abs(int(x['prognose'])-int(x['ist'])) for x in sel)/sum(int(x['ist']) for x in sel)\ny25=[x for x in rows if '2024-12-30'<=x['woche']<='2025-12-22' and x['prognose'] and x['ist']]\nprint('2025 all',len(y25),acc(y25))\nex=[x for x in y25 if 'ausverkauft' not in x['hinweis']];print('excl sold',len(ex),acc(ex))\nex2=[x for x in ex if not x['hinweis']];print('excl all notes',len(ex2),acc(ex2))\nfor lab,sel in [('2024',[x for x in rows if x['woche']<'2024-12-30' and x['prognose']]),('2025',y25)]:\n    e=[int(x['ist'])-int(x['prognose']) for x in sel if not x['hinweis']]\n    print(lab,'mean err',st.mean(e),'sd',st.pstdev(e))\n# errors ist-prog, clean weeks, after delisting adaptation (from 2025-05-19)\ncl=[x for x in rows if x['prognose'] and x['ist'] and not x['hinweis']]\ne=[int(x['ist'])-int(x['prognose']) for x in cl]\nprint('all clean n',len(e),'mean',st.mean(e),'sd',st.pstdev(e))\nq=sorted(e);n=len(q)\nfor p in (0.5,0.75,0.79,0.8,0.85,0.9):print(p,q[int(p*n)])\nrec=[x for x in cl if x['woche']>='2025-06-01']\ner=[int(x['ist'])-int(x['prognose']) for x in rec];print('recent n',len(er),'mean',st.mean(er),'sd',st.pstdev(er),sorted(er))\n# errors as ratio\nrat=sorted(int(x['ist'])/int(x['prognose']) for x in cl);print('ratio quantiles',[round(rat[int(p*len(rat))],3) for p in (0.5,0.79,0.8)])\n# delisting window\nfor x in rows:\n  if '2025-04-07'<=x['woche']<='2025-06-02': print(x['woche'],x['ist'],x['prognose'],int(x['ist'])-int(x['prognose']))\nE",
        "description": "Recompute accuracy and analyze forecast errors"
