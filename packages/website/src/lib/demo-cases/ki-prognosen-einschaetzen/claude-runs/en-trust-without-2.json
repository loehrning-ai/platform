        "command": "cd .; python3 -I - <<'EOF'\nimport csv,statistics as st\nR={r['week']:r for r in csv.DictReader(open('lentil-soup-weekly.csv'),delimiter=';')}\nrs=[r for w,r in sorted(R.items()) if w>='2025-05-19' and r['actual'] and r['forecast'] and not r['note']]\nd=sorted(int(r['actual'])-int(r['forecast']) for r in rs);print(len(d),st.mean(d),st.pstdev(d),d)\nfor p in [.484,.5,.789]: print(p,d[int(p*len(d))])\n# cost of order Q given forecast 729 + errors (empirical, all 2025 non-event)\nrs2=[r for w,r in sorted(R.items()) if '2024-12-30'<=w<='2025-12-22' and r['actual'] and r['forecast'] and not r['note']]\ne=[int(r['actual'])-int(r['forecast']) for r in rs2]\nfor base in [729,700]:\n  for Q in range(680,800,10):\n    c=st.mean(1.5*max(base+x-Q,0)+0.4*max(Q-base-x,0) for x in e)\n    c2=st.mean(1.5*max(base+x-Q,0)+1.6*max(Q-base-x,0) for x in e)\n    print(base,Q,round(c,1),round(c2,1))\nEOF",
