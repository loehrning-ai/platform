      "input": {
        "command": "cd .; python3 -I - <<'EOF'\nimport csv,statistics as st\nrows=list(csv.DictReader(open('lentil-soup-weekly.csv'),delimiter=';'))\nseen=set();R=[]\nfor r in rows:\n    if r['week'] in seen: print('dup',r['week']);continue\n    seen.add(r['week']);R.append(r)\ndef acc(rs):\n    e=sum(abs(int(r['forecast'])-int(r['actual'])) for r in rs);a=sum(int(r['actual']) for r in rs);return 1-e/a\ny25=[r for r in R if '2024-12-30'<=r['week']<='2025-12-22' and r['forecast'] and r['actual']]\nprint('n',len(y25),'acc all',acc(y25))\nex=[r for r in y25 if 'sold out' not in r['note']]\nprint('acc excl soldout',acc(ex),len(ex))\n# naive: last week's actual\ndef naive(rs,all_):\n    idx={r['week']:i for i,r in enumerate(all_)}\n    e=a=0\n    for r in rs:\n        p=all_[idx[r['week']]-1]['actual'];e+=abs(int(p)-int(r['actual']));a+=int(r['actual'])\n    return 1-e/a\nprint('naive',naive(ex,R))\n# bias\nfor name,rs in [('2025 all',ex),('excl events',[r for r in ex if not r['note']])]:\n    d=[int(r['actual'])-int(r['forecast']) for r in rs]\n    print(name,'mean err',st.mean(d),'sd',st.pstdev(d),'mean ratio',st.mean(int(r['actual'])/int(r['forecast']) for r in rs))\n# recent 13 weeks\nrec=[r for r in R if r['week']>='2025-09-29' and r['actual']]\nd=[int(r['actual'])-int(r['forecast']) for r in rec]\nprint('recent',d,st.mean(d),st.pstdev(d))\nq=[int(r['actual'])/int(r['forecast']) for r in ex if not r['note']]\nq.sort();import math\nfor p in [.5,.75,.789,.8,.85,.9]:\n    print(p,q[min(len(q)-1,int(p*len(q)))])\nd=sorted(int(r['actual'])-int(r['forecast']) for r in ex if not r['note'])\nprint('errs',d,len(d))\nfor p in [.5,.789,.484]: print(p,d[int(p*len(d))])\nEOF",
        "description": "Recompute accuracy, bias and error quantiles"
      }
