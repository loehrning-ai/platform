        "command": "cd .; python3 -I - <<'E'\nimport csv,statistics as st\nrows=list(csv.DictReader(open('linsensuppe-woechentlich.csv'),delimiter=';'))\nseen=set();R=[]\nfor r in rows:\n  if r['woche'] in seen: print('dup',r['woche']);continue\n  seen.add(r['woche']);R.append(r)\ndef acc(sel,name):\n  a=sum(abs(int(r['prognose'])-int(r['ist'])) for r in sel); s=sum(int(r['ist']) for r in sel)\n  e=[int(r['ist'])-int(r['prognose']) for r in sel]\n  print(name,len(sel),'acc',round(1-a/s,4),'bias(ist-prog)',round(st.mean(e),1),'sd',round(st.pstdev(e),1))\n  return e\nok=lambda r:r['ist'] and r['prognose']\ny25=[r for r in R if '2024-12-30'<=r['woche']<='2025-12-22' and ok(r)]\nacc([r for r in y25 if 'ausverkauft' not in r['hinweis']],'tool def')\nacc(y25,'incl sold out')\nplain=[r for r in y25 if not r['hinweis']]\nacc(plain,'no notes 2025')\npost=[r for r in R if '2025-04-14'<=r['woche']<='2025-12-22' and ok(r) and not r['hinweis']]\ne=acc(post,'post-delist no notes')\npre=[r for r in R if r['woche']<'2025-04-07' and ok(r) and not r['hinweis']]\nacc(pre,'pre-delist')\nfor lo,hi in [('2025-04-14','2025-06-30'),('2025-07-01','2025-09-30'),('2025-10-01','2025-12-31')]:\n  acc([r for r in post if lo<=r['woche']<=hi],lo)\n# ratio forecast at year end\ndef ratios(sel): return sorted(int(r['ist'])/int(r['prognose']) for r in sel)\nq=ratios(post); n=len(q)\nimport math\nfor p in (0.5,0.7,0.79,0.85,0.9): print(p, round(q[min(n-1,int(p*n))],3), round(729*q[min(n-1,int(p*n))]))\n# newsvendor scan with empirical ratios\nfor Co in (0.40,1.60):\n  best=min(range(600,900),key=lambda Q: sum(1.5*max(0,729*x-Q)+Co*max(0,Q-729*x) for x in q))\n  print('Co',Co,'best Q',best)\nw=[r for r in R if r['woche'] in('2024-12-16','2024-12-23','2024-12-30','2025-01-06')];print([(r['woche'],r['ist'],r['prognose']) for r in w])\nE",
        "description": "Analyze forecast accuracy and bias"
      }
