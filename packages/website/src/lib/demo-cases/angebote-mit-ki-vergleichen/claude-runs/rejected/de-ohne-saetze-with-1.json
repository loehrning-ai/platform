        "command": "python3 -I - <<'EOF'\nQ=40000\nA_goods=0.66*Q; B_goods=520/1000*Q; C_goods=57.50/100*Q\nB_tool=1450.0\nA_sk=-0.02*A_goods; B_sk=-0.02*B_goods; C_sk=-0.03*C_goods\nprint(\"Ware\",A_goods,B_goods,C_goods)\nprint(\"Skonto\",A_sk,B_sk,C_sk)\nA=A_goods+A_sk; B=B_goods+B_tool+B_sk; C=C_goods+C_sk\nprint(\"Summe ohne Fracht/Lager, mit Skonto\",A,B,C)\nprint(\"Spielraum Fracht+Lager vs A, mit Skonto: B\",A-B,\"C\",A-C)\nAn=A_goods; Bn=B_goods+B_tool; Cn=C_goods\nprint(\"ohne Skonto\",An,Bn,Cn,\"Spielraum B\",An-Bn,\"C\",An-Cn)\nprint(\"Lieferungen: B\",Q/20000,\"C\",Q/10000)\n# C Papierzuschlag: Zuschlag = 0.6*Ware*p ; bis A: C + 0.6*C_goods*p = A\nprint(\"Papierindex-Anstieg, ab dem C (ohne Fracht/Lager) teurer als A:\",(A-C)/(0.6*C_goods))\nprint(\"Zuschlag je 1% Indexanstieg:\",0.6*C_goods*0.01)\nEOF",
        "description": "Compute offer comparison on common basis"
      }
