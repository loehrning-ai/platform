        "command": "mkdir -p calc && cat > calc/vergleich.py <<'EOF'\nfrom decimal import Decimal as D\nQ = D(40000)  # anfrage.md:16\na = {\"stk\": D(\"0.66\"), \"einm\": D(0), \"sk\": D(\"0.02\")}           # A:16, A:19, A:24\nb = {\"stk\": D(\"520.00\")/1000, \"einm\": D(\"1450.00\"), \"sk\": D(\"0.02\")}  # B:13, B:21, B:17\nc = {\"stk\": D(\"57.50\")/100, \"einm\": D(0), \"sk\": D(\"0.03\")}      # C:15, C:11, C:19\nfor n, o in ((\"A\", a), (\"B\", b), (\"C\", c)):\n    ware = o[\"stk\"] * Q\n    sk = ware * o[\"sk\"]  # nur auf Ware (B:22, C:24)\n    print(n, \"Stück\", o[\"stk\"], \"Ware\", ware, \"Einmalig\", o[\"einm\"],\n          \"Skonto\", -sk, \"Teilsumme o. Sk\", ware + o[\"einm\"], \"mit Sk\", ware + o[\"einm\"] - sk)\n# Papierzuschlag C: 0,6 * Warenwert * Steigerung\nwc = c[\"stk\"] * Q\nprint(\"C Zuschlag je 1 % Index:\", D(\"0.6\") * wc * D(\"0.01\"))\nEOF\npython3 -I calc/vergleich.py",
        "description": "Compute offers on common basis"
      }
