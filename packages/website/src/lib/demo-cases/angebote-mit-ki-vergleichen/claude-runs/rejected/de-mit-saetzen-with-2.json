      "tool": "Bash",
      "input": {
        "command": "python3 -I -c '\nQ=40000\n# A Nuernberg: DAP, 0,66/Stk, 2% Skonto auf Ware\nA=dict(ware=0.66*Q,fracht=0,einm=0,lager=0); A[\"skonto\"]=-0.02*A[\"ware\"]\n# B Poznan: 520/1000, min 20.000 je Auftrag -> 2 Lieferungen a 20 Paletten, EXW\nB=dict(ware=0.52*Q,fracht=2*1400,einm=1450,lager=(20-10)*16*12); B[\"skonto\"]=-0.02*B[\"ware\"]\n# C Brno: 57,50/100, 10.000 je Lieferung -> 4 Fahrten a 10 Paletten, FCA\nC=dict(ware=57.50/100*Q,fracht=4*650,einm=0,lager=max(0,10-10)*16*12); C[\"skonto\"]=-0.03*C[\"ware\"]\nfor n,d in ((\"A\",A),(\"B\",B),(\"C\",C)):\n    d[\"summe\"]=sum(d.values()); print(n,{k:round(v,2) for k,v in d.items()})\nprint(\"C vs A\",A[\"summe\"]-C[\"summe\"],\"Kipp-Papier%\",100*(A[\"summe\"]-C[\"summe\"])/(0.6*C[\"ware\"]))\nprint(\"C vs B\",B[\"summe\"]-C[\"summe\"],\"Kipp-Papier%\",100*(B[\"summe\"]-C[\"summe\"])/(0.6*C[\"ware\"]))\nprint(\"B alt 1x40k: lager\",(40-10)*16*12)\n'",
        "description": "Calculate annual delivered cost per offer"
      }
    },
