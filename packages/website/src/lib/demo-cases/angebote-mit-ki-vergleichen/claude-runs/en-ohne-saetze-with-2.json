        "command": "python3 -I - <<'EOF'\nQ=40000\noffers={\n \"A Nürnberg\":dict(unit=0.66, oneoff=0, sk=0.02),\n \"B Poznań\":dict(unit=520/1000, oneoff=1450, sk=0.02),\n \"C Brno\":dict(unit=57.50/100, oneoff=0, sk=0.03),\n}\nres={}\nfor k,o in offers.items():\n    goods=o[\"unit\"]*Q; sk=goods*o[\"sk\"]  # skonto on goods only (B tooling, C surcharge excluded)\n    res[k]=(goods,o[\"oneoff\"],sk,goods+o[\"oneoff\"]-sk,goods+o[\"oneoff\"])\n    print(f\"{k:12} unit {o['unit']:.4f} goods {goods:9.2f} oneoff {o['oneoff']:8.2f} skonto -{sk:7.2f} total(w/ sk) {goods+o['oneoff']-sk:9.2f} total(no sk) {goods+o['oneoff']:9.2f}\")\nA,B,C=(res[k] for k in offers)\nprint(\"A-B with/without skonto\", A[3]-B[3], A[4]-B[4])\nprint(\"A-C with/without skonto\", A[3]-C[3], A[4]-C[4])\nprint(\"C-B with/without skonto\", C[3]-B[3], C[4]-B[4])\n# paper surcharge: 0.6*goods*rise, not discountable\nfor name,gap in [(\"C vs B\",B[3]-C[3]),(\"C vs A\",A[3]-C[3])]:\n    print(name,\"index rise to flip:\", gap/(0.6*C[0])*100 if gap>0 else \"already behind\")\nEOF",
