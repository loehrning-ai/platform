      "tool": "Bash",
      "input": {
        "command": "python3 -I - <<'EOF'\nQ=40000\noffers={\n \"A Nürnberg\":dict(p=0.66,tool=0,sk=0.02),\n \"B Poznań\":dict(p=520/1000,tool=1450,sk=0.02),\n \"C Brno\":dict(p=57.50/100,tool=0,sk=0.03),\n}\nr={}\nfor n,o in offers.items():\n    ware=round(o[\"p\"]*Q,2); skonto=round(ware*o[\"sk\"],2)\n    r[n]=(ware,o[\"tool\"],skonto,ware+o[\"tool\"]-skonto,ware+o[\"tool\"])\n    print(n, \"Stück\",o[\"p\"],\"Ware\",ware,\"Einmalig\",o[\"tool\"],\"Skonto\",-skonto,\"Summe m. Sk\",r[n][3],\"o. Sk\",r[n][4])\nA=r[\"A Nürnberg\"];B=r[\"B Poznań\"];C=r[\"C Brno\"]\nprint(\"Spielraum Fracht+Lager B ggü A: mSk\",A[3]-B[3],\" oSk\",A[4]-B[4])\nprint(\"Spielraum Fracht+Lager C ggü A: mSk\",A[3]-C[3],\" oSk\",A[4]-C[4])\nprint(\"C - B ohne Fracht/Lager: mSk\",C[3]-B[3],\" oSk\",C[4]-B[4])\n# Papierzuschlag: 0.6*Ware*x, nicht skontofähig\nfor lbl,i in ((\"mSk\",3),(\"oSk\",4)):\n    x=(A[i]-C[i])/(0.6*C[0]); print(\"Papierindex-Anstieg, bei dem C ohne Fracht/Lager A erreicht\",lbl,round(x*100,1),\"%\")\nprint(\"Zuschlag je 1 % Indexanstieg:\",0.6*C[0]*0.01)\nEOF",
        "description": "Compute annual landed cost per offer"
      }
    },
