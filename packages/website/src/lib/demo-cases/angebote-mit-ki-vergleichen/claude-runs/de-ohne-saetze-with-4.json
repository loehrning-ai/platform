        "command": "python3 -I - <<'EOF'\nQ=40000\no={\n 'A':dict(p=0.66,one=0,sk=0.02,src='A Z.16, Z.19, Z.24'),\n 'B':dict(p=520/1000,one=1450,sk=0.02,src='B Z.13, Z.21-22, Z.17'),\n 'C':dict(p=57.50/100,one=0,sk=0.03,src='C Z.15, Z.11, Z.19'),\n}\nfor k,v in o.items():\n    g=round(v['p']*Q,2); s=round(g*v['sk'],2)\n    v.update(g=g,s=s,known_net=g+v['one'],known_sk=g+v['one']-s)\n    print(k,f\"Stk {v['p']:.4f}  Ware {g:,.2f}  Einm {v['one']:,.2f}  Skonto -{s:,.2f}  Summe bekannt o.Sk {v['known_net']:,.2f}  m.Sk {v['known_sk']:,.2f}\")\nA=o['A'];B=o['B'];C=o['C']\nprint('Abstand A-B m.Sk',A['known_sk']-B['known_sk'],'o.Sk',A['known_net']-B['known_net'])\nprint('Abstand A-C m.Sk',A['known_sk']-C['known_sk'],'o.Sk',A['known_net']-C['known_net'])\nprint('Abstand C-B m.Sk',C['known_sk']-B['known_sk'],'o.Sk',C['known_net']-B['known_net'])\nbase=0.6*C['g']\nprint('Papierzuschlag-Basis',base)\nprint('Index-Anstieg bis C=A (ohne Fracht/Lager) m.Sk',(A['known_sk']-C['known_sk'])/base,'o.Sk',(A['known_net']-C['known_net'])/base)\nEOF",
        "description": "Compute offer comparison figures"
      }
    },
