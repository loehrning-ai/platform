      "text": "import csv, sys, collections as C\n\nd = sys.argv[1]\nprice = {}\nfor r in csv.DictReader(open(d + '/product_lines.csv')):\n    price[(r['line'], r['model_code'])] = float(r['base_price_eur'])\n\nU = C.defaultdict(int); R = C.defaultdict(float); W = C.defaultdict(set); bad = 0\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    p = r['sku'].split('-'); line, model = p[1], p[2]; m = r['week_start'][:7]\n    W[m].add(r['week_start']); u = int(r['units_actual']); U[(m, line)] += u\n    if (line, model) in price:\n        R[(m, line)] += u * price[(line, model)]\n    else:\n        bad += 1\nprint('weeks', {k: sorted(v) for k, v in W.items()}, 'unpriced', bad)\nfor k in sorted(U):\n    print(k, U[k], round(R[k]))\n\nN = C.defaultdict(lambda: [0, 0]); T = C.defaultdict(lambda: [0, 0]); S = C.defaultdict(int)\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    m = r['ncr_date'][:7]; k = (m, r['line'])\n    N[k][0] += 1; N[k][1] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT':\n        T[(m, r['ncr_type'])][0] += 1; T[(m, r['ncr_type'])][1] += int(r['qty_affected'])\n        S[(m, r['scrap_or_rework'])] += int(r['qty_affected'])\nprint('NCR')\nfor k in sorted(N):\n    u = U.get(k, 0)\n    print(k, N[k], 'units', u,\n          'ncr/1000', round(N[k][0] / u * 1000, 2) if u else '-',\n          'affected%', round(N[k][1] / u * 100, 1) if u else '-')\nprint(dict(T)); print(dict(S))\n"
