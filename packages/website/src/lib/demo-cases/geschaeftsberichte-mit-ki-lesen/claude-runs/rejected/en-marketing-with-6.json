      "input": {
        "file_path": "scripts/a.py",
        "content": "import csv, sys, collections as C\n\nd = sys.argv[1]\nprice = {(r['line'], r['model_code']): float(r['base_price_eur']) for r in csv.DictReader(open(d + '/product_lines.csv'))}\nU = C.Counter(); R = C.Counter(); W = C.defaultdict(set); WU = C.Counter(); rows = C.Counter()\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    m = r['week_start'][:7]; p = r['sku'].split('-'); ln = p[1]; u = int(r['units_actual'])\n    U[(ln, m)] += u; R[(ln, m)] += u * price[(ln, p[2])]; W[m].add(r['week_start']); WU[(ln, r['week_start'])] += u\n    rows[(ln, m)] += 1\nprint('weeks', {m: sorted(w) for m, w in W.items()})\nN = C.Counter(); Q = C.Counter(); T = C.defaultdict(C.Counter); S = C.defaultdict(C.Counter)\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    k = (r['line'], r['ncr_date'][:7]); N[k] += 1; Q[k] += int(r['qty_affected'])\n    T[k][r['ncr_type']] += 1; S[k][r['scrap_or_rework']] += int(r['qty_affected'])\nlines = sorted({k[0] for k in U} | {k[0] for k in N})\nfor m in sorted({k[1] for k in U} | {k[1] for k in N}):\n    print('==', m, 'weeks', len(W.get(m, [])))\n    for l in lines:\n        u = U[(l, m)]; n = N[(l, m)]; q = Q[(l, m)]\n        print(l, 'rows', rows[(l, m)], 'units', u, 'rev', round(R[(l, m)]), 'ncr', n, 'qty', q,\n              'ncr/1k', round(1000 * n / u, 2) if u else '-', 'qty%', round(100 * q / u, 2) if u else '-', dict(S[(l, m)]))\nprint('CRAFT weekly', sorted((w, v) for (l, w), v in WU.items() if l == 'CRAFT'))\nprint('CRAFT types', {m: dict(T[('CRAFT', m)]) for m in ['2023-08', '2023-09']})\n"
      }
