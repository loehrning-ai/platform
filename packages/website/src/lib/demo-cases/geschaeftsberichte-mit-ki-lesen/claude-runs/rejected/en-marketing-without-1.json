      "input": {
        "command": "cd .; python3 -I - <<'EOF'\nimport csv,collections as C\nP={(r['line'],r['model_code']):int(r['base_price_eur']) for r in csv.DictReader(open('product_lines.csv'))}\nU=C.Counter();R=C.Counter();W=C.defaultdict(C.Counter)\nfor r in csv.DictReader(open('demand_actuals.csv')):\n    _,l,m,*_=r['sku'].split('-'); mo=r['week_start'][:7]; u=int(r['units_actual'])\n    U[l,mo]+=u; R[l,mo]+=u*P[l,m]; W[l][r['week_start']]+=u\nN=C.Counter();Q=C.Counter();NW=C.defaultdict(C.Counter);T=C.defaultdict(C.Counter)\nfor r in csv.DictReader(open('ncr_records.csv')):\n    l=r['line'];d=r['ncr_date'];N[l,d[:7]]+=1;Q[l,d[:7]]+=int(r['qty_affected']);NW[l][d]+=1\n    if l=='CRAFT':T[d[:7]][r['ncr_type']]+=1\nlines=sorted({k[0] for k in list(U)+list(N)})\nprint(\"line  Aug_u Sep_u Aug_rev Sep_rev | AugNCR SepNCR Aug/1k Sep/1k | perwk NCR aug sep | qty aug sep\")\nfor l in lines:\n    a,s=U[l,'2023-08'],U[l,'2023-09']\n    f=lambda n,u: round(n/u*1000,2) if u else None\n    print(l,a,s,R[l,'2023-08'],R[l,'2023-09'],'|',N[l,'2023-08'],N[l,'2023-09'],f(N[l,'2023-08'],a),f(N[l,'2023-09'],s),'|',N[l,'2023-08']/4,N[l,'2023-09']/5,'|',Q[l,'2023-08'],Q[l,'2023-09'], 'qty/1k',f(Q[l,'2023-08'],a),f(Q[l,'2023-09'],s))\nprint('CRAFT weekly units',dict(sorted(W['CRAFT'].items())))\nprint('CRAFT NCR by date',dict(sorted(NW['CRAFT'].items())))\nprint(dict(T))\nEOF",
        "description": "Recompute revenue, NCR rates per line and month"
