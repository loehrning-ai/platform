      "text": "import csv, sys, os, collections as C\nd = sys.argv[1]\nP = {(r['line'], r['model_code']): int(r['base_price_eur']) for r in csv.DictReader(open(os.path.join(d, 'product_lines.csv')))}\nU = C.Counter(); R = C.Counter(); W = C.defaultdict(C.Counter)\nfor r in csv.DictReader(open(os.path.join(d, 'demand_actuals.csv'))):\n    _, l, m, *_ = r['sku'].split('-'); mo = r['week_start'][:7]; u = int(r['units_actual'])\n    U[l, mo] += u; R[l, mo] += u * P[l, m]; W[l][r['week_start']] += u\nN = C.Counter(); Q = C.Counter(); NW = C.defaultdict(C.Counter); T = C.defaultdict(C.Counter)\nfor r in csv.DictReader(open(os.path.join(d, 'ncr_records.csv'))):\n    l = r['line']; dt = r['ncr_date']; N[l, dt[:7]] += 1; Q[l, dt[:7]] += int(r['qty_affected']); NW[l][dt] += 1\n    if l == 'CRAFT': T[dt[:7]][r['ncr_type'] + '/' + r['scrap_or_rework']] += 1\nlines = sorted({k[0] for k in list(U) + list(N)})\nf = lambda n, u: round(n / u * 1000, 2) if u else None\nprint(\"line Aug_u Sep_u Aug_rev Sep_rev | NCR aug sep | /1k aug sep | NCR/wk aug sep | qty aug sep | qty/1k aug sep\")\nfor l in lines:\n    a, s = U[l, '2023-08'], U[l, '2023-09']\n    print(l, a, s, R[l, '2023-08'], R[l, '2023-09'], '|', N[l, '2023-08'], N[l, '2023-09'], '|', f(N[l, '2023-08'], a), f(N[l, '2023-09'], s),\n          '|', N[l, '2023-08'] / 4, N[l, '2023-09'] / 5, '|', Q[l, '2023-08'], Q[l, '2023-09'], '|', f(Q[l, '2023-08'], a), f(Q[l, '2023-09'], s))\nprint('CRAFT weekly units', sorted(W['CRAFT'].items()))\nprint('CRAFT NCR by date', sorted(NW['CRAFT'].items()))\nfor k, v in T.items(): print(k, dict(v))\n"
