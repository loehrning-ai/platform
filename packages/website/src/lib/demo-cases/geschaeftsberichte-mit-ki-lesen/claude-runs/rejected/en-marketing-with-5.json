      "text": "import csv, sys, collections as C\nd = sys.argv[1]\nprice = {(r['line'], r['model_code']): float(r['base_price_eur']) for r in csv.DictReader(open(d + '/product_lines.csv'))}\nU = C.defaultdict(float); R = C.defaultdict(float); miss = set()\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    p = r['sku'].split('-'); line, m = p[1], p[2]; w = r['week_start']; mo = w[:7]\n    u = float(r['units_actual'])\n    if (line, m) not in price:\n        miss.add((line, m)); continue\n    U[(line, mo, w)] += u; R[(line, mo, w)] += u * price[(line, m)]\nprint('missing', miss)\nlines = sorted({k[0] for k in U})\nfor l in lines:\n    for mo in ['2023-08', '2023-09']:\n        ws = sorted({k[2] for k in U if k[0] == l and k[1] == mo})\n        print(l, mo, len(ws), 'units', sum(U[(l, mo, w)] for w in ws), 'rev', round(sum(R[(l, mo, w)] for w in ws)), [int(U[(l, mo, w)]) for w in ws])\nN = C.defaultdict(lambda: [0, 0, C.Counter(), C.Counter()])\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    k = (r['line'], r['ncr_date'][:7]); N[k][0] += 1; N[k][1] += int(r['qty_affected'])\n    N[k][2][r['scrap_or_rework']] += int(r['qty_affected']); N[k][3][r['ncr_date'] >= '2023-09-30'] += 1\nfor k in sorted(N): print(k, N[k])\n"
