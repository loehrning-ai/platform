        "file_path": "scripts/check.py",
        "content": "import csv, sys, collections\nd = sys.argv[1]\npl = list(csv.DictReader(open(f\"{d}/product_lines.csv\")))\nfor r in pl: print(r)\nprice = {}\nfor r in pl: price[(r[\"line\"], r[\"model_code\"])] = float(r[\"base_price_eur\"])\n\ndem = list(csv.DictReader(open(f\"{d}/demand_actuals.csv\")))\nweeks = sorted({(r[\"week_start\"], r[\"fiscal_week_year\"]) for r in dem})\nprint(\"weeks:\", weeks)\nprint(\"sample skus:\", sorted({r[\"sku\"] for r in dem})[:10])\nunits = collections.defaultdict(int); rev = collections.defaultdict(float)\nwk_by_m = collections.defaultdict(set)\nfor r in dem:\n    m = r[\"week_start\"][:7]\n    p = r[\"sku\"].split(\"-\"); line = p[1]\n    model = p[2][1:] if False else None\n    u = int(r[\"units_actual\"])\n    units[(line, m)] += u\n    wk_by_m[m].add(r[\"week_start\"])\nfor k in sorted(units): print(k, units[k])\nprint({m: len(w) for m, w in wk_by_m.items()})\n\nncr = list(csv.DictReader(open(f\"{d}/ncr_records.csv\")))\ncnt = collections.defaultdict(int); qty = collections.defaultdict(int)\ntypes = collections.defaultdict(collections.Counter)\nfor r in ncr:\n    m = r[\"ncr_date\"][:7]\n    cnt[(r[\"line\"], m)] += 1; qty[(r[\"line\"], m)] += int(r[\"qty_affected\"])\n    types[(r[\"line\"], m)][r[\"scrap_or_rework\"]] += int(r[\"qty_affected\"])\nprint(\"NCR dates:\", min(r[\"ncr_date\"] for r in ncr), max(r[\"ncr_date\"] for r in ncr))\nfor k in sorted(cnt):\n    u = units.get(k, 0)\n    print(k, \"ncr\", cnt[k], \"qty\", qty[k], \"units\", u,\n          \"ncr/1k\", round(cnt[k]/u*1000, 2) if u else None,\n          \"qty%\", round(qty[k]/u*100, 2) if u else None, dict(types[k]))\n"
      }
