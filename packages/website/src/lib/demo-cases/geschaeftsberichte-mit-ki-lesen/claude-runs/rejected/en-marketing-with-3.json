      "text": "import csv, sys, collections as C\n\nd = sys.argv[1]\nprice = {}\nfor r in csv.DictReader(open(d + '/product_lines.csv')):\n    price[(r['line'], r['model_code'])] = float(r['base_price_eur'])\n\nU = C.Counter(); R = C.Counter(); W = C.defaultdict(set); miss = set()\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    p = r['sku'].split('-'); line, mc = p[1], p[2]; m = r['week_start'][:7]\n    u = int(r['units_actual']); U[(line, m)] += u; W[m].add(r['week_start'])\n    if (line, mc) in price:\n        R[(line, m)] += u * price[(line, mc)]\n    else:\n        miss.add(r['sku'])\nprint('weeks', {m: sorted(v) for m, v in W.items()}, 'missing price', miss)\n\nN = C.Counter(); Q = C.Counter(); T = C.defaultdict(C.Counter)\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    m = r['ncr_date'][:7]; N[(r['line'], m)] += 1; Q[(r['line'], m)] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT':\n        T[m][r['ncr_type'] + '/' + r['scrap_or_rework']] += int(r['qty_affected'])\n\nlines = sorted({k[0] for k in U})\nfor m in ['2023-08', '2023-09']:\n    nw = len(W[m]); print('\\n', m, 'weeks', nw)\n    for l in lines:\n        u = U[(l, m)]; n = N[(l, m)]; q = Q[(l, m)]\n        print(f\"{l:6} units {u:7} u/wk {u/nw:8.0f} rev {R[(l, m)]:12,.0f} NCR {n:3} \"\n              f\"NCR/1k {1000*n/u:5.2f} affected {q:5} aff% {100*q/u:5.1f}\")\n    print('total units', sum(U[(l, m)] for l in lines), 'rev', f\"{sum(R[(l, m)] for l in lines):,.0f}\")\nfor m in sorted(T):\n    print(m, dict(T[m]))\n"
