      "input": {
        "file_path": "scripts/check.py",
        "content": "import csv, collections, sys, os\n\nd = sys.argv[1]\nprice = {(r['line'], r['model_code']): float(r['base_price_eur'])\n         for r in csv.DictReader(open(os.path.join(d, 'product_lines.csv')))}\n\nU = collections.Counter(); R = collections.Counter(); rows = collections.Counter()\nW = collections.defaultdict(set); miss = set()\nfor r in csv.DictReader(open(os.path.join(d, 'demand_actuals.csv'))):\n    m = r['week_start'][:7]; p = r['sku'].split('-'); k = (p[1], p[2])\n    if k not in price: miss.add(r['sku'])\n    U[(m, p[1])] += int(r['units_actual']); rows[(m, p[1])] += 1\n    R[(m, p[1])] += int(r['units_actual']) * price.get(k, 0)\n    W[m].add(r['week_start'])\nprint('skus without price:', miss)\nfor m in sorted(W): print(m, len(W[m]), sorted(W[m]))\nfor k in sorted(U):\n    print(k, 'rows', rows[k], 'units', U[k], 'rev', round(R[k]), 'units/wk', round(U[k] / len(W[k[0]])))\n\nN = collections.Counter(); Q = collections.Counter(); S = collections.Counter(); T = collections.Counter()\nfor r in csv.DictReader(open(os.path.join(d, 'ncr_records.csv'))):\n    k = (r['ncr_date'][:7], r['line'])\n    N[k] += 1; Q[k] += int(r['qty_affected']); S[(k, r['scrap_or_rework'])] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT': T[(k[0], r['ncr_type'])] += int(r['qty_affected'])\nfor k in sorted(N):\n    u = U.get(k)\n    print(k, 'ncr', N[k], 'qty', Q[k], 'scrap', S[(k, 'scrap')], 'rework', S[(k, 'rework')], 'units', u,\n          'ncr/1000', round(N[k] / u * 1000, 2) if u else None, 'qty%', round(Q[k] / u * 100, 1) if u else None)\nprint(sorted(T.items()))\n"
      }
