        "command": "python3 -I - . <<'EOF'\nimport csv,collections,sys,os\nd=sys.argv[1]\nprice={(r['line'],r['model_code']):float(r['base_price_eur']) for r in csv.DictReader(open(os.path.join(d,'product_lines.csv')))}\nU=collections.Counter();R=collections.Counter();W=collections.defaultdict(set);miss=set();rows=collections.Counter()\nfor r in csv.DictReader(open(os.path.join(d,'demand_actuals.csv'))):\n    m=r['week_start'][:7]; p=r['sku'].split('-'); k=(p[1],p[2])\n    if k not in price: miss.add(r['sku'])\n    U[(m,p[1])]+=int(r['units_actual']); W[m].add(r['week_start']); rows[(m,p[1])]+=1\n    R[(m,p[1])]+=int(r['units_actual'])*price.get(k,0)\nprint('missing',miss)\nfor m in sorted(W): print(m,sorted(W[m]))\nfor k in sorted(U): print(k,'rows',rows[k],'units',U[k],'rev',round(R[k]),'per wk',round(U[k]/len(W[k[0]])))\nN=collections.Counter();Q=collections.Counter();S=collections.Counter();T=collections.Counter()\nfor r in csv.DictReader(open(os.path.join(d,'ncr_records.csv'))):\n    k=(r['ncr_date'][:7],r['line']);N[k]+=1;Q[k]+=int(r['qty_affected'])\n    S[(k,r['scrap_or_rework'])]+=int(r['qty_affected'])\n    if r['line']=='CRAFT': T[(k[0],r['ncr_type'])]+=int(r['qty_affected'])\nfor k in sorted(N): print(k,'ncr',N[k],'qty',Q[k],'scrap',S[(k,'scrap')],'rework',S[(k,'rework')],'units',U.get(k),'ncr/1000',round(N[k]/U[k]*1000,2) if U.get(k) else None,'qty%',round(Q[k]/U[k]*100,1) if U.get(k) else None)\nprint(T)\nEOF",
