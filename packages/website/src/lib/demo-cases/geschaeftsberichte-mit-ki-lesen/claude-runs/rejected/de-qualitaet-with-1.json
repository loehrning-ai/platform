        "command": "cat > scripts/ncr.py <<'EOF'\nimport csv, sys, collections as C\nd = sys.argv[1]\nu = C.defaultdict(int)\nuw = C.defaultdict(int)\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    line = r['sku'].split('-')[1]\n    u[(line, r['week_start'][:7])] += int(r['units_actual'])\n    uw[(line, r['week_start'])] += int(r['units_actual'])\nn = C.defaultdict(int)\nq = C.defaultdict(int)\ndates = C.Counter()\nqd = C.Counter()\ntyp = C.Counter()\nsr = C.Counter()\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    k = (r['line'], r['ncr_date'][:7])\n    n[k] += 1\n    q[k] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT':\n        dates[r['ncr_date']] += 1\n        qd[r['ncr_date']] += int(r['qty_affected'])\n        typ[(k[1], r['ncr_type'])] += 1\n        sr[(k[1], r['scrap_or_rework'])] += int(r['qty_affected'])\nlines = sorted(set(k[0] for k in list(u) + list(n)))\nfor l in lines:\n    for m in ['2023-08', '2023-09']:\n        U = u[(l, m)]\n        print(l, m, U, n[(l, m)], q[(l, m)], round(n[(l, m)] / U * 1000, 2) if U else '-', round(q[(l, m)] / U * 100, 1) if U else '-')\nprint(sorted(dates.items()))\nprint(sorted(qd.items()))\nprint(sorted(typ.items()))\nprint(sorted(sr.items()))\nprint(sorted((k, v) for k, v in uw.items() if k[0] == 'CRAFT'))\nEOF",
