        "command": "mkdir -p scripts && cat > scripts/ncr.py <<'EOF'\nimport csv, sys, collections as C\nd = sys.argv[1]\nu = C.defaultdict(int); uw = C.defaultdict(int)\nfor r in csv.DictReader(open(d + '/demand_actuals.csv')):\n    line = r['sku'].split('-')[1]; m = r['week_start'][:7]\n    u[(line, m)] += int(r['units_actual']); uw[(line, r['week_start'])] += int(r['units_actual'])\nn = C.defaultdict(int); q = C.defaultdict(int); dates = C.Counter(); typ = C.Counter(); sr = C.defaultdict(int); qd = C.defaultdict(int)\nfor r in csv.DictReader(open(d + '/ncr_records.csv')):\n    k = (r['line'], r['ncr_date'][:7]); n[k] += 1; q[k] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT':\n        dates[r['ncr_date']] += 1; qd[r['ncr_date']] += int(r['qty_affected'])\n        typ[(r['ncr_date'][:7], r['ncr_type'])] += 1\n        sr[(r['ncr_date'][:7], r['scrap_or_rework'])] += int(r['qty_affected'])\nlines = sorted(set(k[0] for k in list(u) + list(n)))\nprint(\"line month units ncr qty ncr/1000 qty%\")\nfor l in lines:\n    for m in ['2023-08', '2023-09']:\n        U = u[(l, m)]\n        print(l, m, U, n[(l, m)], q[(l, m)], round(n[(l, m)] / U * 1000, 2) if U else '-', round(q[(l, m)] / U * 100, 1) if U else '-')\nprint(sorted(dates.items())); print(sorted(qd.items()))\nprint(sorted(typ.items())); print(sorted(sr.items()))\nprint(sorted((k, v) for k, v in uw.items() if k[0] == 'CRAFT'))\nprint(sum(v for (l, m), v in u.items() if m == '2023-09'), sum(v for (l, m), v in u.items() if m == '2023-08'))\nEOF\npython3 -I scripts/ncr.py .",
        "description": "Compute NCR counts, affected qty and units per line and month"
