      "input": {
        "command": "python3 -I - <<'EOF'\nimport csv,collections as C\nprice={(r['line'],r['model_code']):int(r['base_price_eur']) for r in csv.DictReader(open('product_lines.csv'))}\nU=C.Counter();R=C.Counter();W=C.defaultdict(set);WU=C.Counter();miss=0\nfor r in csv.DictReader(open('demand_actuals.csv')):\n    _,l,m,*_=r['sku'].split('-');mo=r['week_start'][:7];u=int(r['units_actual'])\n    U[l,mo]+=u;W[mo].add(r['week_start']);WU[l,r['week_start']]+=u\n    if (l,m) in price: R[l,mo]+=u*price[l,m]\n    else: miss+=1\nprint('missing price',miss,{k:sorted(v) for k,v in W.items()})\nprint('Total',{mo:(sum(v for (l,m),v in U.items() if m==mo),sum(v for (l,m),v in R.items() if m==mo)) for mo in W})\nN=C.Counter();Q=C.Counter();T=C.Counter()\nfor r in csv.DictReader(open('ncr_records.csv')):\n    k=(r['line'],r['ncr_date'][:7]);N[k]+=1;Q[k]+=int(r['qty_affected']);T[k+(r['ncr_type'],)]+=1\nlines=sorted({l for l,_ in U}|{l for l,_ in N})\nprint('line mo units rev ncr qty ncr/1000 qty%')\nfor l in lines:\n  for mo in ['2023-08','2023-09']:\n    u=U[l,mo];print(l,mo,u,R[l,mo],N[l,mo],Q[l,mo],round(N[l,mo]/u*1000,2) if u else '-',round(Q[l,mo]/u*100,1) if u else '-')\nprint('CRAFT weekly',[(w,WU['CRAFT',w]) for w in sorted({w for _,w in WU})])\nprint({k:v for k,v in T.items() if k[0]=='CRAFT'})\nEOF",
        "description": "Recompute units, revenue, NCR metrics per line and month"
      }
