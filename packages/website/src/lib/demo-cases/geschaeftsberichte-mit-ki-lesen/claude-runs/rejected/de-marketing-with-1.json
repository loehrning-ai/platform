      "input": {
        "command": "mkdir -p scripts && cat > scripts/craft.py <<'EOF'\nimport csv, sys, os, collections as C\nd = sys.argv[1]\nprice = {}\nfor r in csv.DictReader(open(os.path.join(d, 'product_lines.csv'))):\n    price[(r['line'], r['model_code'])] = int(r['base_price_eur'])\nU = C.Counter(); R = C.Counter(); W = C.defaultdict(set); WU = C.Counter(); miss = 0\nfor r in csv.DictReader(open(os.path.join(d, 'demand_actuals.csv'))):\n    p = r['sku'].split('-'); l, m = p[1], p[2]\n    mo = r['week_start'][:7]; u = int(r['units_actual'])\n    U[l, mo] += u; W[mo].add(r['week_start']); WU[l, r['week_start']] += u\n    if (l, m) in price: R[l, mo] += u * price[l, m]\n    else: miss += 1\nprint('missing price', miss)\nfor mo in sorted(W): print(mo, sorted(W[mo]), sum(v for k, v in U.items() if k[1] == mo), sum(v for k, v in R.items() if k[1] == mo))\nN = C.Counter(); Q = C.Counter(); T = C.Counter(); rows = []\nfor r in csv.DictReader(open(os.path.join(d, 'ncr_records.csv'))):\n    k = (r['line'], r['ncr_date'][:7]); N[k] += 1; Q[k] += int(r['qty_affected'])\n    if r['line'] == 'CRAFT': T[r['ncr_date'][:7], r['ncr_type'], r['scrap_or_rework']] += 1\nlines = sorted(set(k[0] for k in U) | set(k[0] for k in N))\nprint('line mo units rev ncr qty ncr/1000 qty%')\nfor l in lines:\n    for mo in ['2023-08', '2023-09']:\n        u = U[l, mo]\n        print(l, mo, u, R[l, mo], N[l, mo], Q[l, mo], round(N[l, mo]/u*1000, 2) if u else '-', round(Q[l, mo]/u*100, 1) if u else '-')\nweeks = sorted(set(k[1] for k in WU))\nprint('CRAFT weekly', [(w, WU['CRAFT', w]) for w in weeks])\nprint('ALL weekly', [(w, sum(v for k, v in WU.items() if k[1] == w)) for w in weeks])\nfor k in sorted(T): print(k, T[k])\nEOF\npython3 -I scripts/craft.py .",
        "description": "Recompute units, revenue, NCR metrics per line"
