        "command": "cd .; python3 -I - <<'EOF'\nimport csv,collections as C\npl={}\nfor r in csv.DictReader(open('product_lines.csv')): pl[(r['line'],r['model_code'])]=float(r['base_price_eur'])\nd=C.defaultdict(lambda:[0,0.0]); weeks=C.defaultdict(set)\nfor r in csv.DictReader(open('demand_actuals.csv')):\n    p=r['sku'].split('-'); m=r['week_start'][:7]; u=int(r['units_actual'])\n    d[(m,p[1])][0]+=u; d[(m,p[1])][1]+=u*pl[(p[1],p[2])]; weeks[m].add(r['week_start'])\nfor m in sorted(weeks): print(m,sorted(weeks[m]))\nn=C.defaultdict(lambda:[0,0]); types=C.Counter(); disp=C.Counter()\nfor r in csv.DictReader(open('ncr_records.csv')):\n    m=r['ncr_date'][:7]; n[(m,r['line'])][0]+=1; n[(m,r['line'])][1]+=int(r['qty_affected'])\n    if r['line']=='CRAFT': types[(m,r['ncr_type'])]+=1; disp[(m,r['scrap_or_rework'])]+=int(r['qty_affected'])\nprint(sorted(set(k[0] for k in n)))\nfor line in sorted(set(k[1] for k in d)|set(k[1] for k in n)):\n  for m in ['2023-08','2023-09']:\n    u,rev=d[(m,line)]; c,q=n[(m,line)]; w=len(weeks[m]) or 1\n    print(line,m,u,round(rev),'u/wk',round(u/w),'ncr',c,'ncr/wk',round(c/w,2),'aff',q,'per1k',round(c/u*1000,2) if u else None,'aff%',round(q/u*100,1) if u else None)\nprint(types); print(disp)\nEOF",
        "description": "Recompute units, revenue, NCR rates per month and week"
      }
