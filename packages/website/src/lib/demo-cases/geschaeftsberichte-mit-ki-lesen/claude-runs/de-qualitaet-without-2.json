        "command": "cd .; python3 -I - <<'EOF'\nimport pandas as pd\nn=pd.read_csv('ncr_records.csv',parse_dates=['ncr_date'])\nd=pd.read_csv('demand_actuals.csv',parse_dates=['week_start'])\nprint(n.ncr_date.min(),n.ncr_date.max()); print(n.line.value_counts())\nprint(n.ncr_id.duplicated().sum(), n.duplicated(subset=n.columns[1:]).sum())\nd['line']=d.sku.str.split('-').str[1]\nprint(d.groupby(['fiscal_week_year','week_start']).units_actual.sum())\nd['m']=d.week_start.dt.month; n['m']=n.ncr_date.dt.month\nn['wk']=n.ncr_date.dt.to_period('W-FRI')\nc=n[n.line=='CRAFT']\nprint(c.groupby('m').agg(cnt=('ncr_id','count'),qty=('qty_affected','sum')))\nprint(c.groupby('wk').agg(cnt=('ncr_id','count'),qty=('qty_affected','sum')))\nprint(c.groupby(['m','ncr_type']).size().unstack(0))\nprint(c.groupby(['m','scrap_or_rework']).qty_affected.sum().unstack(0))\nu=d[d.line=='CRAFT'].groupby('m').units_actual.sum(); print(u)\nprint(d[d.line=='CRAFT'].groupby('week_start').units_actual.sum())\nfor L in n.line.unique():\n  a=n[n.line==L].groupby('m').size(); uu=d[d.line==L].groupby('m').units_actual.sum()\n  print(L, dict(a), dict(uu), dict((a/uu*1000).round(2)), dict((n[n.line==L].groupby('m').qty_affected.sum()/uu*100).round(1)))\nprint(c.sort_values('ncr_date').to_string())\nEOF",
        "description": "Analyze NCR and demand data for CRAFT"
