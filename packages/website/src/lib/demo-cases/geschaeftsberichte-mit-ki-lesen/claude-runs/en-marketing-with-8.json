        "command": "python3 -I - <<'EOF'\nimport csv,collections\nprice={}\nfor r in csv.DictReader(open('product_lines.csv')): price[(r['line'],r['model_code'])]=float(r['base_price_eur'])\nU=collections.defaultdict(float);R=collections.defaultdict(float);W=collections.defaultdict(float)\nfor r in csv.DictReader(open('demand_actuals.csv')):\n    _,line,mc,*_=r['sku'].split('-'); m=r['week_start'][:7]; u=int(r['units_actual'])\n    U[(line,m)]+=u; R[(line,m)]+=u*price[(line,mc)]; W[(line,r['week_start'])]+=u\nprint('CRAFT weekly',[ (k[1],v) for k,v in sorted(W.items()) if k[0]=='CRAFT'])\nfor line in sorted({k[0] for k in U}):\n    a,s=U[(line,'2023-08')],U[(line,'2023-09')]\n    print(line,a,s,round(R[(line,'2023-09')]),f\"{s/a-1:+.1%}\", f\"perwk {(s/5)/(a/4)-1:+.1%}\")\nprint('tot',sum(v for k,v in U.items() if k[1]=='2023-09'),sum(v for k,v in R.items() if k[1]=='2023-09'))\nN=collections.defaultdict(lambda:[0,0]); NW=collections.defaultdict(lambda:[0,0])\ntypes=collections.Counter()\nfor r in csv.DictReader(open('ncr_records.csv')):\n    k=(r['line'],r['ncr_date'][:7]); N[k][0]+=1; N[k][1]+=int(r['qty_affected'])\n    if r['line']=='CRAFT': NW[r['ncr_date']][0]+=1; NW[r['ncr_date']][1]+=int(r['qty_affected']); types[(r['ncr_date'][:7],r['ncr_type'],r['scrap_or_rework'])]+=1\nfor k in sorted(N):\n    u=U[k]; print(k,N[k], 'NCR/1k',round(N[k][0]/u*1000,2),'affected%',round(N[k][1]/u*100,1))\nprint(sorted(NW.items())); print(sorted(types.items()))\nEOF",
        "description": "Recompute units, revenue, NCR rates per line and month"
      }
