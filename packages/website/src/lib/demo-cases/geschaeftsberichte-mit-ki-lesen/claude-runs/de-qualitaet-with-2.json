      "input": {
        "command": "python3 -I - <<'EOF'\nimport csv, collections as C\nd=list(csv.DictReader(open('demand_actuals.csv')))\nprint(sorted(set((r['fiscal_week_year'],r['week_start']) for r in d)))\nunits=C.defaultdict(int); wk=C.defaultdict(set)\nfor r in d:\n    m=r['week_start'][:7]; l=r['sku'].split('-')[1]\n    units[(m,l)]+=int(r['units_actual']); wk[m].add(r['week_start'])\nprint({m:len(s) for m,s in wk.items()})\nn=list(csv.DictReader(open('ncr_records.csv')))\nprint(sorted(set(r['ncr_date'][:7] for r in n)))\ncnt=C.Counter(); qty=C.Counter(); typ=C.Counter()\nfor r in n:\n    k=(r['ncr_date'][:7],r['line']); cnt[k]+=1; qty[k]+=int(r['qty_affected'])\n    if r['line']=='CRAFT': typ[(r['ncr_date'][:7],r['scrap_or_rework'])]+=int(r['qty_affected'])\nfor k in sorted(set(cnt)|set(units)):\n    u=units[k]; c=cnt[k]; q=qty[k]\n    print(k,u,c,q, round(c/u*1000,2) if u else '-', round(q/u*100,1) if u else '-')\nprint(typ)\nids=[r['ncr_id'] for r in n]; print(len(ids),len(set(ids)))\nEOF",
        "description": "Recompute NCR counts, affected units and rates per line and month"
      }
    },
