{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__foldline-ready__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/sql_guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(psql:*)",
      "Read(./.env)"
    ]
  }
}
