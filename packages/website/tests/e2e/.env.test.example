# Authenticated E2E variable-name template.
# Inject real values through the invoking shell or CI secret facility. The
# scripts read process.env directly and do not load a copied .env.test file.
# Never commit credentials to the repository.
#
# SETUP STEPS:
# 1. Create a dedicated Supabase test project (separate from production) at:
#    https://supabase.com/dashboard/projects
# 2. Create a confirmed test user via the Supabase dashboard or:
#    supabase.auth.admin.createUser({ email, password, email_confirm: true })
# 3. Ensure password auth is enabled: Auth > Providers > Email > Password
# 4. Fill in the values below
# 5. Keep the six values in the local/CI secret facility. Never commit the
#    populated file. A service-role key is neither required nor accepted.

SIMPLIFIED_SUPABASE_TEST_URL=https://<test-project-ref>.supabase.co
SIMPLIFIED_SUPABASE_TEST_PUBLISHABLE_KEY=<test-project-publishable-key>
SIMPLIFIED_SUPABASE_TEST_EMAIL=test@example.com
SIMPLIFIED_SUPABASE_TEST_PASSWORD=<test-user-password>
NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<test-project-publishable-key>
